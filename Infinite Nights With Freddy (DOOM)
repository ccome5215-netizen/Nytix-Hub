local function resolveFunction(name)
	local ok, value = pcall(function()
		return getgenv()[name]
	end)
	if ok and value then
		return value
	end
	ok, value = pcall(function()
		return getfenv(0)[name]
	end)
	if ok and value then
		return value
	end
	ok, value = pcall(function()
		return _G[name]
	end)
	if ok and value then
		return value
	end
	return nil
end

