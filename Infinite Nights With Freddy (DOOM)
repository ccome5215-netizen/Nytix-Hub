local function buildBananaTargets()
	local list = {}
	local folder = Workspace:FindFirstChild("Animatronics")
	if folder then
		local names = {}
		for name in pairs(Selected.animatronics) do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in ipairs(names) do
			local model = folder:FindFirstChild(name)
			if model and model:GetAttribute("AnimatronicEnabled") == true then
				local part = getRootPart(model)
				if part then
					table.insert(list, part)
				end
			end
		end
	end
	do
		local names = {}
		for name in pairs(Selected.players) do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in ipairs(names) do
			local plr = Players:FindFirstChild(name)
			local char = plr and plr ~= LocalPlayer and plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and root then
				table.insert(list, root)
			end
		end
	end
	return list
end

local function bananaTick()
	local targets = buildBananaTargets()
	local count = #targets
	if count == 0 then
		return
	end
	local list = {}
	if Tornado.on then
		for _, inst in ipairs(Tornado.reserved) do
			if inst.Parent and not Fling.set[inst] then
				table.insert(list, inst)
			end
		end
	else
		for inst in pairs(Banana.owned) do
			if inst.Parent and not Fling.set[inst] then
				table.insert(list, inst)
			end
		end
	end
	local total = #list
	if total == 0 then
		return
	end
	local moved = 0
	local checked = 0
	local limit = math.min(total, math.max(Banana.maxChecks, Banana.perCycle * 4))
	while moved < Banana.perCycle and checked < limit do
		Banana.cursor = (Banana.cursor % total) + 1
		checked += 1
		local inst = list[Banana.cursor]
		local part = inst:IsA("BasePart") and inst or getRootPart(inst)
		if part and Banana.owned[inst] then
			local slot = Banana.slot[inst]
			if not slot then
				Banana.counter += 1
				slot = Banana.counter
			end
			Banana.slot[inst] = slot + 1
			local cf = targets[(slot % count) + 1].CFrame
			if inst:IsA("Model") then
				inst:PivotTo(cf)
			else
				inst.CFrame = cf
			end
			part.AssemblyLinearVelocity = Vector3.zero
			moved += 1
		end
	end
end

local function bananaSet(value)
	if value == Banana.on then
		return
	end
	Banana.token += 1
	local token = Banana.token
	Banana.on = value
	if not value then
		bananaTrack(false)
		return
	end
	bananaTrack(true)
	task.spawn(function()
		local lastBoost = 0
		while Banana.token == token do
			if os.clock() - lastBoost > 2 then
				lastBoost = os.clock()
				boostSimulation()
			end
			pcall(bananaTick)
			task.wait(0.15)
		end
	end)
end

local function flingStep()
	local targets = buildBananaTargets()
	local count = #targets
	if count == 0 then
		return
	end
	local active = 0
	for banana in pairs(Fling.set) do
		local part = banana:IsA("BasePart") and banana or getRootPart(banana)
		if not banana.Parent or not part or not Banana.owned[banana] then
			Fling.set[banana] = nil
		else
			active += 1
		end
	end
	local now = os.clock()
	if active < Fling.amount and now - Fling.lastFill > 0.25 then
		Fling.lastFill = now
		for inst in pairs(Banana.owned) do
			if active >= Fling.amount then
				break
			end
			if inst.Parent and not Fling.set[inst] then
				local part = inst:IsA("BasePart") and inst or getRootPart(inst)
				if part and Banana.owned[inst] then
					Fling.set[inst] = true
					active += 1
				end
			end
		end
	end
	if active == 0 then
		return
	end
	if now - Fling.lastSwitch > 0.5 then
		Fling.lastSwitch = now
		Fling.index += 1
	end
	local cf = targets[(Fling.index % count) + 1].CFrame
	for banana in pairs(Fling.set) do
		local part = banana:IsA("BasePart") and banana or getRootPart(banana)
		if part then
			if banana:IsA("Model") then
				banana:PivotTo(cf)
			else
				banana.CFrame = cf
			end
			local push = Vector3.new(math.random(-100, 100), math.random(50, 100), math.random(-100, 100))
			part.AssemblyLinearVelocity = push.Unit * 100000
			part.AssemblyAngularVelocity = Vector3.new(10000, 10000, 10000)
		end
	end
end

local function flingSet(value)
	if value == Fling.on then
		return
	end
	Fling.token += 1
	local token = Fling.token
	Fling.on = value
	if not value then
		table.clear(Fling.set)
		bananaTrack(false)
		return
	end
	Fling.index = 0
	Fling.lastSwitch = 0
	Fling.lastFill = 0
	bananaTrack(true)
	task.spawn(function()
		local lastBoost = 0
		while Fling.token == token do
			if os.clock() - lastBoost > 2 then
				lastBoost = os.clock()
				boostSimulation()
			end
			pcall(flingStep)
			task.wait()
		end
	end)
end

function Tornado.balance()
	local want = Banana.on and Banana.perCycle or 0
	for i = #Tornado.reserved, 1, -1 do
		local inst = Tornado.reserved[i]
		if not inst.Parent or Fling.set[inst] or i > want then
			Tornado.reservedSet[inst] = nil
			table.remove(Tornado.reserved, i)
			if inst.Parent and not Fling.set[inst] then
				Tornado.members[inst] = true
				Tornado.dirty = true
			end
		end
	end
	if #Tornado.reserved < want then
		for inst in pairs(Tornado.members) do
			if #Tornado.reserved >= want then
				break
			end
			Tornado.members[inst] = nil
			Tornado.reservedSet[inst] = true
			table.insert(Tornado.reserved, inst)
			Tornado.dirty = true
		end
	end
end

function Tornado.claim()
	local now = os.clock()
	if now - Tornado.poolTime > 0.5 then
		Tornado.poolTime = now
		table.clear(Tornado.pool)
		for inst in pairs(Banana.owned) do
			if inst.Parent then
				table.insert(Tornado.pool, inst)
			end
		end
	end
	local total = #Tornado.pool
	if total == 0 then
		return
	end
	for _ = 1, math.min(total, 30) do
		Tornado.cursor = (Tornado.cursor % total) + 1
		local inst = Tornado.pool[Tornado.cursor]
		if inst.Parent and not Fling.set[inst] and not Tornado.members[inst] and not Tornado.reservedSet[inst] then
			local part = inst:IsA("BasePart") and inst or getRootPart(inst)
			if part and Banana.owned[inst] then
				Tornado.members[inst] = true
				Tornado.dirty = true
			end
		end
	end
end

function Tornado.move()
	local root = getRoot()
	if not root then
		return
	end
	if Tornado.dirty then
		Tornado.dirty = false
		table.clear(Tornado.list)
		for inst in pairs(Tornado.members) do
			table.insert(Tornado.list, inst)
		end
	end
	local total = #Tornado.list
	if total == 0 then
		return
	end
	local base = root.Position
	local started = os.clock()
	local index = Tornado.moveCursor
	local processed = 0
	while processed < total do
		index = (index % total) + 1
		processed += 1
		local inst = Tornado.list[index]
		if Tornado.members[inst] then
			local part = inst:IsA("BasePart") and inst or getRootPart(inst)
			if not inst.Parent or Fling.set[inst] or not part or not Banana.owned[inst] then
				Tornado.members[inst] = nil
				Tornado.dirty = true
			else
				local rise = ((index * 0.61803398875) % 1 + started * 0.35) % 1
				local angle = started * (7 - rise * 3) + index * 2.399963
				local radius = 14 + rise * 26 + math.sin(started * 3 + index) * 2
				local height = -2 + rise * 47
				local position = base + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
				local cf = CFrame.new(position) * CFrame.Angles(started * 5 + index, started * 7, 0)
				if inst:IsA("Model") then
					inst:PivotTo(cf)
				else
					inst.CFrame = cf
				end
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
		if os.clock() - started > 0.002 then
			break
		end
	end
	Tornado.moveCursor = index
end

function Tornado.set(value)
	if value == Tornado.on then
		return
	end
	Tornado.on = value
	if value then
		bananaTrack(true)
		Tornado.conn = RunService.Heartbeat:Connect(function()
			if os.clock() - Tornado.lastBoost > 2 then
				Tornado.lastBoost = os.clock()
				boostSimulation()
			end
			pcall(Tornado.balance)
			pcall(Tornado.claim)
			pcall(Tornado.move)
		end)
	else
		if Tornado.conn then
			Tornado.conn:Disconnect()
			Tornado.conn = nil
		end
		bananaTrack(false)
		table.clear(Tornado.members)
		table.clear(Tornado.list)
		table.clear(Tornado.reserved)
		table.clear(Tornado.reservedSet)
		table.clear(Tornado.pool)
		Tornado.dirty = false
	end
end

local function createLock(getEntries)
	local lock = { entries = {}, conns = {}, on = false }
	local function track(entry)
		lock.entries[entry] = { original = entry.inst[entry.prop] }
		entry.inst[entry.prop] = entry.value
		table.insert(lock.conns, entry.inst:GetPropertyChangedSignal(entry.prop):Connect(function()
			if lock.on and entry.inst[entry.prop] ~= entry.value then
				entry.inst[entry.prop] = entry.value
			end
		end))
	end
	local seen = {}
	function lock.refresh()
		if not lock.on then
			return
		end
		for _, entry in ipairs(getEntries()) do
			local perInstance = seen[entry.inst]
			if not perInstance then
				perInstance = {}
				seen[entry.inst] = perInstance
			end
			if not perInstance[entry.prop] then
				perInstance[entry.prop] = true
				track(entry)
			end
		end
	end
	function lock.set(value)
		if value then
			lock.on = true
			table.insert(lock.conns, Lighting.ChildAdded:Connect(function()
				task.defer(lock.refresh)
			end))
			lock.refresh()
		else
			lock.on = false
			for _, conn in ipairs(lock.conns) do
				conn:Disconnect()
			end
			lock.conns = {}
			for entry, data in pairs(lock.entries) do
				if entry.inst.Parent then
					pcall(function()
						entry.inst[entry.prop] = data.original
					end)
				end
			end
			lock.entries = {}
			seen = {}
		end
	end
	return lock
end

