local TrashJob = {
	enabled = false,
	active = false,
	returns = true,
	fast = true,
	freezeCam = true,
	toolNames = { "Cleaning tool" },
	target = nil,
	guardHum = nil,
}

local function getTrashFolder()
	return findPath(Workspace, "Map", "Trash", "CurrentTrash")
end

local function trashPromptValid(prompt, folder)
	return prompt and prompt.Parent and prompt:IsDescendantOf(folder) and prompt.Enabled
end

local TrashCache = { folder = nil, prompts = {}, conns = {} }

function TrashCache.reset()
	for _, conn in ipairs(TrashCache.conns) do
		conn:Disconnect()
	end
	table.clear(TrashCache.conns)
	table.clear(TrashCache.prompts)
	TrashCache.folder = nil
end

function TrashCache.sync(folder)
	if TrashCache.folder == folder then
		return
	end
	TrashCache.reset()
	if not folder then
		return
	end
	TrashCache.folder = folder
	for _, inst in ipairs(folder:GetDescendants()) do
		if inst.Name == "CleanPrompt" and inst:IsA("ProximityPrompt") then
			TrashCache.prompts[inst] = true
		end
	end
	table.insert(TrashCache.conns, folder.DescendantAdded:Connect(function(inst)
		if inst.Name == "CleanPrompt" and inst:IsA("ProximityPrompt") then
			TrashCache.prompts[inst] = true
		end
	end))
	table.insert(TrashCache.conns, folder.DescendantRemoving:Connect(function(inst)
		TrashCache.prompts[inst] = nil
	end))
end

function TrashCache.position(prompt)
	local parent = prompt.Parent
	if parent then
		if parent:IsA("BasePart") then
			return parent.Position
		end
		if parent:IsA("Attachment") then
			return parent.WorldPosition
		end
	end
	local cf = getCFrame(prompt)
	return cf and cf.Position
end

table.insert(CleanupFns, TrashCache.reset)

local function findTrashPrompt()
	local folder = getTrashFolder()
	TrashCache.sync(folder)
	if not folder then
		return nil
	end
	if trashPromptValid(TrashJob.target, folder) then
		return TrashJob.target
	end
	local root = getRoot()
	local origin = root and root.Position or Vector3.zero
	local best, bestDistance = nil, math.huge
	for prompt in pairs(TrashCache.prompts) do
		if prompt.Parent and prompt.Enabled then
			local position = TrashCache.position(prompt)
			if position then
				local distance = (position - origin).Magnitude
				if distance < bestDistance then
					best = prompt
					bestDistance = distance
				end
			end
		end
	end
	TrashJob.target = best
	return best
end

function TrashJob.wants()
	return findTrashPrompt() ~= nil
end

function TrashJob.step()
	local prompt = findTrashPrompt()
	if not prompt then
		return
	end
	applyTripGuard(TrashJob)
	teleportTo(getCFrame(prompt))
	local times = ownsJobTool(TrashJob) and 5 or 20
	if prompt.HoldDuration ~= 0 then
		prompt.HoldDuration = 0
	end
	for _ = 1, times do
		firePrompt(prompt)
	end
	local fired = times
	local root = getRoot()
	if not root then
		return
	end
	local here = root.Position
	for other in pairs(TrashCache.prompts) do
		if fired + times > 100 then
			break
		end
		if other ~= prompt and other.Parent and other.Enabled then
			local position = TrashCache.position(other)
			if position and (position - here).Magnitude <= other.MaxActivationDistance * 0.9 then
				if other.HoldDuration ~= 0 then
					other.HoldDuration = 0
				end
				for _ = 1, times do
					firePrompt(other)
				end
				fired += times
			end
		end
	end
end

function TrashJob.idle()
	if TrashCache.folder then
		TrashCache.reset()
	end
end

function TrashJob.onFinish()
	TrashJob.target = nil
	releaseTripGuard(TrashJob)
end

