local function freezeCamera()
	local cam = Workspace.CurrentCamera
	if cam and cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
end

local function cameraHeldByJob()
	for _, job in ipairs(Jobs) do
		if job.freezeCam and job.active then
			return true
		end
	end
	return false
end

local function findToolIn(container, lowered)
	if not container then
		return nil
	end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") and child.Name:lower() == lowered then
			return child
		end
	end
	return nil
end

local function findToolByName(name)
	local lowered = name:lower()
	return findToolIn(getChar(), lowered) or findToolIn(LocalPlayer:FindFirstChildOfClass("Backpack"), lowered)
end

local function maintainJobTool(job)
	if AutoSlap.on then
		return
	end
	for _, name in ipairs(job.toolNames) do
		local tool = findToolByName(name)
		if tool then
			local hum = getHum()
			if hum and tool.Parent ~= getChar() then
				pcall(function()
					hum:EquipTool(tool)
				end)
			end
			return
		end
	end
end

local function ownsJobTool(job)
	for _, name in ipairs(job.toolNames) do
		if findToolByName(name) then
			return true
		end
	end
	return false
end

local function toolHeldByJob()
	for _, job in ipairs(Jobs) do
		if job.toolNames and job.active then
			return true
		end
	end
	return false
end

local function restoreJobTool(job)
	local prev = Scheduler.prevTool
	Scheduler.prevTool = nil
	if AutoSlap.on then
		return
	end
	local char = getChar()
	local hum = getHum()
	if not char or not hum then
		return
	end
	if prev and prev.Parent and (prev.Parent == char or prev.Parent == LocalPlayer:FindFirstChildOfClass("Backpack")) then
		pcall(function()
			hum:EquipTool(prev)
		end)
		return
	end
	for _, name in ipairs(job.toolNames) do
		if findToolIn(char, name:lower()) then
			pcall(function()
				hum:UnequipTools()
			end)
			return
		end
	end
end

local function finishJob(job)
	job.active = false
	local origin = job.origin
	job.origin = nil
	if job.onFinish then
		pcall(job.onFinish)
	end
	if job.freezeCam and not cameraHeldByJob() then
		resetCamera()
	end
	if job.toolNames and not toolHeldByJob() then
		restoreJobTool(job)
	end
	if job.returns and origin then
		teleportTo(origin)
	end
end

local function anyJobOn()
	for _, job in ipairs(Jobs) do
		if job.enabled or job.active then
			return true
		end
	end
	return false
end

local function schedulerTick()
	local root = getRoot()
	if not root then
		return
	end
	for _, job in ipairs(Jobs) do
		if job.enabled or job.active then
			local okWants, needs = pcall(job.wants)
			if okWants and needs then
				if not job.active then
					if job.toolNames and not AutoSlap.on and not toolHeldByJob() then
						local char = getChar()
						Scheduler.prevTool = char and char:FindFirstChildOfClass("Tool")
					end
					job.active = true
					job.origin = root.CFrame
				end
				if job.freezeCam then
					freezeCamera()
				end
				if job.toolNames then
					maintainJobTool(job)
				end
				pcall(job.step)
				return job
			elseif job.active then
				finishJob(job)
			end
		elseif job.idle then
			job.idle()
		end
	end
	return nil
end

local function ensureScheduler()
	if Scheduler.running then
		return
	end
	Scheduler.running = true
	task.spawn(function()
		while anyJobOn() do
			local ran = schedulerTick()
			if ran and ran.fast then
				task.wait()
			else
				task.wait(0.1)
			end
		end
		for _, job in ipairs(Jobs) do
			if job.idle then
				pcall(job.idle)
			end
		end
		Scheduler.running = false
	end)
end

local function setJob(job, value)
	job.enabled = value
	if value then
		ensureScheduler()
	end
end

local TripStates = {
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.PlatformStanding,
	Enum.HumanoidStateType.Physics,
}

local function applyTripGuard(job)
	local hum = getHum()
	if not hum then
		return
	end
	if job.guardHum ~= hum then
		job.guardHum = hum
		pcall(function()
			for _, state in ipairs(TripStates) do
				hum:SetStateEnabled(state, false)
			end
		end)
	end
	if hum.PlatformStand then
		hum.PlatformStand = false
	end
	local current = hum:GetState()
	if table.find(TripStates, current) then
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
end

local function releaseTripGuard(job)
	local hum = job.guardHum
	job.guardHum = nil
	if hum and hum.Parent then
		pcall(function()
			for _, state in ipairs(TripStates) do
				hum:SetStateEnabled(state, true)
			end
		end)
	end
end

