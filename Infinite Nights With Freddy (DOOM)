do
	local function slapTools()
		local list = {}
		local function add(container)
			if container then
				for _, child in ipairs(container:GetChildren()) do
					if child:IsA("Tool") and child.Name:lower():find("slap", 1, true) then
						table.insert(list, child)
					end
				end
			end
		end
		add(LocalPlayer:FindFirstChildOfClass("Backpack"))
		add(getChar())
		return list
	end

	local function autoSlapSet(value)
		if value == AutoSlap.on then
			return
		end
		AutoSlap.token += 1
		local token = AutoSlap.token
		AutoSlap.on = value
		if not value then
			return
		end
		task.spawn(function()
			while AutoSlap.token == token do
				local tools = slapTools()
				for _, tool in ipairs(tools) do
					if AutoSlap.token ~= token then
						break
					end
					local hum = getHum()
					if hum and tool.Parent then
						if tool.Parent ~= getChar() then
							pcall(function()
								hum:EquipTool(tool)
							end)
							task.wait()
						end
						pcall(function()
							tool:Activate()
						end)
					end
					task.wait(0.1)
				end
				if #tools == 0 then
					task.wait(0.1)
				end
			end
		end)
	end

	addToggle("Player", "Auto Slap", function(value)
		autoSlapSet(value)
	end)

	table.insert(CleanupFns, function()
		autoSlapSet(false)
	end)
end

