do
	local dragInput = nil
	local dragStart = nil
	local startPos = nil
	TitleBar.InputBegan:Connect(function(input)
		if dragInput then
			return
		end
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragInput = input
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = Vector2.new(WindowFrame.Position.X.Offset, WindowFrame.Position.Y.Offset)
		end
	end)
	table.insert(Features, UserInputService.InputChanged:Connect(function(input)
		if not dragInput then
			return
		end
		local matches = input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
		if not matches then
			return
		end
		local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
		local vp = WindowGui.AbsoluteSize
		local x = startPos.X + delta.X
		local y = startPos.Y + delta.Y
		if vp.X > 0 and vp.Y > 0 then
			x = math.clamp(x, 0, math.max(0, vp.X - WIN_W))
			y = math.clamp(y, 0, math.max(0, vp.Y - WIN_H))
		end
		WindowFrame.Position = UDim2.fromOffset(x, y)
	end))
	table.insert(Features, UserInputService.InputEnded:Connect(function(input)
		if not dragInput then
			return
		end
		local matches = input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
		if matches then
			dragInput = nil
		end
	end))
end

