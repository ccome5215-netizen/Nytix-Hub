do
	local function collectPeels()
		local found = {}
		for inst in pairs(Banana.owned) do
			if inst.Parent then
				table.insert(found, inst)
			end
		end
		return found
	end

	local function peelPart(inst)
		if inst:IsA("Model") then
			return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
		end
		return inst
	end

	local PeelForce = { amount = 300 }

	addTextBox("Troll", "Force", "300", function(text)
		local value = tonumber(text)
		if value and value == value and math.abs(value) ~= math.huge then
			PeelForce.amount = value
		end
		return tostring(PeelForce.amount)
	end)

	local function flingBananaPeels()
		boostSimulation()
		local parts = {}
		for _, inst in ipairs(collectPeels()) do
			local part = peelPart(inst)
			if part and not part.Anchored then
				table.insert(parts, part)
			end
		end
		local directions = {}
		for index = 1, #parts do
			local dir = Vector3.new(math.random() * 2 - 1, math.random() * 0.8 + 0.2, math.random() * 2 - 1)
			if dir.Magnitude < 0.01 then
				dir = Vector3.new(0, 1, 0)
			end
			directions[index] = dir.Unit
		end
		for _ = 1, 8 do
			for index, part in ipairs(parts) do
				if part.Parent then
					part.AssemblyLinearVelocity = directions[index] * PeelForce.amount
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
			task.wait()
		end
	end

	local function deleteBananaPeels()
		boostSimulation()
		local peels = collectPeels()
		local voidY = math.max(Workspace.FallenPartsDestroyHeight, -50000) - 1000
		for _ = 1, 10 do
			for _, inst in ipairs(peels) do
				if inst.Parent then
					local part = peelPart(inst)
					if part then
						local position = part.Position
						local target = CFrame.new(position.X, voidY, position.Z)
						if inst:IsA("Model") then
							inst:PivotTo(target)
						else
							inst.CFrame = target
						end
						part.AssemblyLinearVelocity = Vector3.zero
						part.AssemblyAngularVelocity = Vector3.zero
					end
				end
			end
			task.wait()
		end
	end

	local function bringBananaPeels()
		boostSimulation()
		local peels = collectPeels()
		local offsets = {}
		for index = 1, #peels do
			offsets[index] = Vector3.new(math.random() * 4 - 2, math.random() * 2 + 1, math.random() * 4 - 2)
		end
		for _ = 1, 3 do
			local root = getRoot()
			if not root then
				return
			end
			local base = root.Position
			for index, inst in ipairs(peels) do
				if inst.Parent then
					local part = peelPart(inst)
					if part then
						local cf = CFrame.new(base + offsets[index])
						if inst:IsA("Model") then
							inst:PivotTo(cf)
						else
							inst.CFrame = cf
						end
						part.AssemblyLinearVelocity = Vector3.zero
						part.AssemblyAngularVelocity = Vector3.zero
					end
				end
			end
			task.wait()
		end
	end

