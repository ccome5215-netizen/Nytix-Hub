function EscapeJob.wants()
	local endPos = findPath(Workspace, "Map", "ImportantSpots", "EndPos")
	if not endPos then
		return false
	end
	local highlight = endPos:FindFirstChild("EscapeHighlight")
	local shopGui = endPos:FindFirstChild("ShopGui")
	local prompt = endPos:FindFirstChild("ProximityPrompt")
	local label = findPath(PlayerGui, "GUI", "In-Game", "TimeFrame", "TimingLabel")
	if not highlight or not shopGui or not prompt or not label then
		return false
	end
	return highlight.Enabled == true and shopGui.Enabled == false and label.Text == "ESCAPE" and isGuiVisible(label)
end

function EscapeJob.step()
