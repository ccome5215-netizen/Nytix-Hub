local function moneyStep()
	local now = os.clock()
	if now - Money.lastResolve > 1 then
		Money.lastResolve = now
		local folder = findPath(Workspace, "Shop", "FunMachine", "Balls")
		if folder ~= Money.folder then
			bindBalls(folder)
		end
		local zones = findPath(Workspace, "Shop", "FunMachine", "Zones")
		Money.halves = {}
		if zones then
			for _, zone in ipairs(zones:GetChildren()) do
				if zone.Name == "Half Good" then
					table.insert(Money.halves, zone)
				end
			end
		end
	end
	local pending = false
	for ball in pairs(Money.balls) do
		if ball.Parent and ownsPart(ball) then
			local zone = nil
			if #Money.halves > 0 then
				local assigned = Money.half[ball]
				if not assigned or not assigned.Parent then
					assigned = Money.halves[math.random(#Money.halves)]
					Money.half[ball] = assigned
				end
				zone = assigned
			end
			if zone then
				local cf = getCFrame(zone)
				if cf and (ball.Position - cf.Position).Magnitude > 1.5 then
					pending = true
					ball.CFrame = cf
					ball.AssemblyLinearVelocity = Vector3.zero
					ball.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end
	end
	if not Money.enabled and (not pending or os.clock() > Money.deadline) then
		moneyHalt()
	end
end

local function moneySet(value)
