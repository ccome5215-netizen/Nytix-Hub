	local data = { objects = {}, conns = {}, char = nil }
	ESP.players[plr] = data
	table.insert(data.conns, plr.CharacterAdded:Connect(function(char)
		applyPlayerESP(plr, char)
	end))
	if plr.Character then
		applyPlayerESP(plr, plr.Character)
	end
end

local function playersESPSet(value)
	if value then
		ESP.playersOn = true
		for _, plr in ipairs(Players:GetPlayers()) do
			hookPlayerESP(plr)
		end
		table.insert(ESP.playerConns, Players.PlayerAdded:Connect(hookPlayerESP))
		table.insert(ESP.playerConns, Players.PlayerRemoving:Connect(clearPlayerESP))
	else
		ESP.playersOn = false
		disconnectAll(ESP.playerConns)
		ESP.playerConns = {}
		for plr in pairs(ESP.players) do
			clearPlayerESP(plr)
		end
	end
end

local function clearAnimESP(model)
	local data = ESP.anim[model]
	if not data then
		return
	end
	ESP.anim[model] = nil
	destroyAll(data.objects)
	disconnectAll(data.conns)
end

local function hookAnimESP(model)
	if ESP.anim[model] or not model:IsA("Model") then
		return
	end
	local data = { objects = {}, conns = {}, labeled = false }
	ESP.anim[model] = data
	local highlight = Instance.new("Highlight")
	highlight.Adornee = model
	highlight.FillTransparency = 0.5
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model
	table.insert(data.objects, highlight)
	local function setColor()
		local color = model:GetAttribute("AnimatronicEnabled") == true and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
		highlight.FillColor = color
		highlight.OutlineColor = color
	end
	setColor()
	table.insert(data.conns, model:GetAttributeChangedSignal("AnimatronicEnabled"):Connect(setColor))
	local function attach()
		if data.labeled then
			return true
		end
		local part = getRootPart(model)
		if not part then
			return false
		end
		data.labeled = true
		table.insert(data.objects, makeNameBillboard(part, model, model.Name, Color3.fromRGB(255, 255, 255)))
		return true
	end
	if not attach() then
		local conn
		conn = model.DescendantAdded:Connect(function()
			if attach() then
				conn:Disconnect()
			end
		end)
		table.insert(data.conns, conn)
	end
end

local function animESPSet(value)
	if value then
		ESP.animOn = true
		ESP.animWatch = watchWorkspaceFolder("Animatronics", hookAnimESP, clearAnimESP)
	else
		ESP.animOn = false
		if ESP.animWatch then
			ESP.animWatch.Stop()
			ESP.animWatch = nil
		end
		for model in pairs(ESP.anim) do
			clearAnimESP(model)
		end
	end
end

