local SpamTool = {
	on = false,
	token = 0,
	stand = nil,
	parts = {},
	prompts = {},
	attrConns = {},
	standConns = {},
	frameConn = nil,
}

local function spamToolUntrack(part)
	SpamTool.parts[part] = nil
	SpamTool.prompts[part] = nil
	local conn = SpamTool.attrConns[part]
	if conn then
		conn:Disconnect()
		SpamTool.attrConns[part] = nil
	end
end

local function spamToolTrack(child)
	if child.ClassName ~= "Part" or SpamTool.attrConns[child] then
		return
	end
	local function refresh()
		local value = child:GetAttribute("Discount")
		if value ~= nil and value ~= false then
			SpamTool.parts[child] = true
		else
			SpamTool.parts[child] = nil
			SpamTool.prompts[child] = nil
		end
	end
	refresh()
	SpamTool.attrConns[child] = child:GetAttributeChangedSignal("Discount"):Connect(refresh)
end

local function spamToolUnbind()
	for _, conn in ipairs(SpamTool.standConns) do
		conn:Disconnect()
	end
	SpamTool.standConns = {}
	for part in pairs(SpamTool.attrConns) do
		spamToolUntrack(part)
	end
	table.clear(SpamTool.parts)
	table.clear(SpamTool.prompts)
	SpamTool.stand = nil
end

local function spamToolBind(stand)
	spamToolUnbind()
	SpamTool.stand = stand
	if not stand then
		return
	end
	table.insert(SpamTool.standConns, stand.ChildAdded:Connect(spamToolTrack))
	table.insert(SpamTool.standConns, stand.ChildRemoved:Connect(spamToolUntrack))
	for _, child in ipairs(stand:GetChildren()) do
		spamToolTrack(child)
	end
end

local function spamToolFrame()
	for part in pairs(SpamTool.parts) do
		local prompt = SpamTool.prompts[part]
		if not prompt or not prompt.Parent then
			prompt = findPath(part, "ToolHandle", "BoothPrompt")
			SpamTool.prompts[part] = prompt
		end
		if prompt then
			for _ = 1, FireTimes.count do
				pcall(Env.fireproximityprompt, prompt)
			end
		end
	end
end

local function spamToolSet(value)
	if value == SpamTool.on then
		return
	end
	SpamTool.token += 1
	local token = SpamTool.token
	SpamTool.on = value
	if not value then
		if SpamTool.frameConn then
			SpamTool.frameConn:Disconnect()
			SpamTool.frameConn = nil
		end
		spamToolUnbind()
		return
	end
	spamToolBind(findPath(Workspace, "Shop", "Stands", "RandomItems"))
	SpamTool.frameConn = RunService.RenderStepped:Connect(spamToolFrame)
	task.spawn(function()
		while SpamTool.token == token do
			local stand = findPath(Workspace, "Shop", "Stands", "RandomItems")
			if stand ~= SpamTool.stand then
				spamToolBind(stand)
			end
			task.wait(1)
		end
	end)
end

local Finder = {
	running = false,
	token = 0,
	wantDiscount = false,
	cooldown = 0.6,
}

local function findOrb()
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local orb = backpack and backpack:FindFirstChild("Orb of shop reset")
	if orb then
		return orb
	end
	local char = getChar()
	return char and char:FindFirstChild("Orb of shop reset")
end

local function findInStand(stand)
	for _, child in ipairs(stand:GetChildren()) do
		if child.ClassName == "Part" and child.Name == Selected.tool then
			local discount = child:GetAttribute("Discount")
			local hasDiscount = discount ~= nil and discount ~= false
			if hasDiscount == Finder.wantDiscount then
				return child
			end
		end
	end
	return nil
end

local function stopFinder(message)
	Finder.running = false
	Finder.token += 1
	local hum = getHum()
	if hum then
		pcall(function()
			hum:UnequipTools()
		end)
	end
	if message then
		notify("Shop", message)
	end
end

local function runFinder(wantDiscount)
	if Finder.running then
		stopFinder("Search stopped.")
		return
	end
	if not Selected.tool then
		notify("Shop", "Please select a tool first.")
		return
	end
	if not findOrb() then
		notify("Shop", "You do not have an Orb of shop reset.")
		return
	end
	Finder.running = true
	Finder.wantDiscount = wantDiscount
	Finder.token += 1
	local token = Finder.token
	task.spawn(function()
		while Finder.running and Finder.token == token do
			local stand = findPath(Workspace, "Shop", "Stands", "RandomItems")
			if not stand then
				stopFinder("RandomItems stand was not found.")
				return
			end
			if findInStand(stand) then
				stopFinder("Found: " .. tostring(Selected.tool))
				return
			end
			local orb = findOrb()
			if not orb then
				stopFinder("Orb of shop reset is gone. Buy one and try again.")
				return
			end
			local hum = getHum()
			if orb.Parent ~= getChar() and hum then
				pcall(function()
					hum:EquipTool(orb)
				end)
			end
			pcall(function()
				orb:Activate()
			end)
			task.wait(Finder.cooldown)
		end
	end)
end

