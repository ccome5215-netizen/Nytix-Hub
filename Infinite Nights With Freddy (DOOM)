local Spam = {}

local FireTimes = { count = 1 }

local function makeSpam(getPrompt)
	local state = { conn = nil }
	function state.start()
		if state.conn then
			return
		end
		local cached = nil
		state.conn = RunService.RenderStepped:Connect(function()
			if not cached or not cached.Parent then
				cached = getPrompt()
			end
			if cached then
				for _ = 1, FireTimes.count do
					pcall(Env.fireproximityprompt, cached)
				end
			end
		end)
	end
	function state.stop()
		if state.conn then
			state.conn:Disconnect()
			state.conn = nil
		end
	end
	return state
end

