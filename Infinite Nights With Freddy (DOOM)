local function unbindBalls()
	if Money.addConn then
		Money.addConn:Disconnect()
		Money.addConn = nil
	end
	if Money.removeConn then
		Money.removeConn:Disconnect()
		Money.removeConn = nil
	end
	Money.folder = nil
	table.clear(Money.balls)
	table.clear(Money.half)
end

local function bindBalls(folder)
	unbindBalls()
	Money.folder = folder
	if not folder then
		return
	end
	local function consider(inst)
		if inst.Name == "BaseBall" and inst.ClassName == "Part" then
			Money.balls[inst] = true
		end
	end
	Money.addConn = folder.DescendantAdded:Connect(consider)
	Money.removeConn = folder.DescendantRemoving:Connect(function(inst)
		Money.balls[inst] = nil
		Money.half[inst] = nil
	end)
	for _, descendant in ipairs(folder:GetDescendants()) do
		consider(descendant)
	end
end

local function moneyHalt()
	if Money.conn then
		Money.conn:Disconnect()
		Money.conn = nil
	end
	Money.draining = false
	unbindBalls()
