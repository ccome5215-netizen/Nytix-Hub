local function insideCharacter(inst)
	if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
		return true
	end
	local ancestor = inst.Parent
	while ancestor and ancestor ~= Workspace do
		if ancestor:IsA("Tool") or (ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid")) then
			return true
		end
		ancestor = ancestor.Parent
	end
	return false
end

local function considerBanana(inst)
	if not (inst:IsA("BasePart") or inst:IsA("Model")) then
		return
	end
	if not inst.Name:lower():find("peel", 1, true) then
		return
	end
	if inst.Parent and Banana.set[inst.Parent] then
		return
	end
	if insideCharacter(inst) then
		return
	end
	Banana.set[inst] = true
end

local function bananaOwnStep()
	local started = os.clock()
	local checks = 0
	for inst in pairs(Banana.set) do
		if not inst.Parent then
			Banana.set[inst] = nil
			Banana.owned[inst] = nil
			Banana.slot[inst] = nil
			Banana.stamp[inst] = nil
		else
			local last = Banana.stamp[inst]
			if not last or started - last >= 1.5 then
				if checks >= 15 or os.clock() - started > 0.002 then
					break
				end
				checks += 1
				Banana.stamp[inst] = started
				local part = inst:IsA("BasePart") and inst or getRootPart(inst)
				if part and ownsPart(part) then
					Banana.owned[inst] = true
				else
					Banana.owned[inst] = nil
				end
			end
		end
	end
end

local function bananaTrack(on)
	if on then
		Banana.users += 1
		if Banana.users > 1 then
			return
		end
		Banana.scanToken += 1
		local token = Banana.scanToken
		Banana.conn = Workspace.DescendantAdded:Connect(considerBanana)
		Banana.removeConn = Workspace.DescendantRemoving:Connect(function(inst)
			Banana.set[inst] = nil
			Banana.owned[inst] = nil
			Banana.stamp[inst] = nil
			Banana.slot[inst] = nil
			Fling.set[inst] = nil
		end)
		Banana.ownConn = RunService.Heartbeat:Connect(bananaOwnStep)
		task.spawn(function()
			local sliceStart = os.clock()
			for _, descendant in ipairs(Workspace:GetDescendants()) do
				if Banana.scanToken ~= token then
					return
				end
				considerBanana(descendant)
				if os.clock() - sliceStart > 0.004 then
					task.wait()
					sliceStart = os.clock()
				end
			end
		end)
	else
		Banana.users = math.max(0, Banana.users - 1)
		if Banana.users > 0 then
			return
		end
		Banana.scanToken += 1
		if Banana.conn then
			Banana.conn:Disconnect()
			Banana.conn = nil
		end
		if Banana.removeConn then
			Banana.removeConn:Disconnect()
			Banana.removeConn = nil
		end
		if Banana.ownConn then
			Banana.ownConn:Disconnect()
			Banana.ownConn = nil
		end
		table.clear(Banana.set)
		table.clear(Banana.owned)
		table.clear(Banana.stamp)
		table.clear(Banana.slot)
	end
end

