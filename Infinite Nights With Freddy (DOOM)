end

local Own = { cache = setmetatable({}, { __mode = "k" }), windowStart = 0, used = 0 }

function Own.check(part)
	local now = os.clock()
	local entry = Own.cache[part]
	if entry and now - entry.time < 1.5 then
		return entry.value
	end
	if now - Own.windowStart >= 0.016 then
		Own.windowStart = now
		Own.used = 0
	end
	if Own.used >= 15 then
		return entry ~= nil and entry.value
	end
	Own.used += 1
	local value = ownsPart(part)
	Own.cache[part] = { value = value, time = now }
	return value
end

local function isGuiVisible(obj)
	local current = obj
	while current and current ~= PlayerGui do
		if current:IsA("GuiObject") then
			if not current.Visible then
				return false
			end
		elseif current:IsA("ScreenGui") then
			if not current.Enabled then
				return false
			end
		end
		current = current.Parent
	end
	return current ~= nil
end

local function watchWorkspaceFolder(name, onAdd, onRemove)
	local handle = { conns = {}, folder = nil }
	local function bind(folder)
		for _, conn in ipairs(handle.conns) do
			conn:Disconnect()
		end
		handle.conns = {}
		handle.folder = folder
		if not folder then
			return
		end
		table.insert(handle.conns, folder.ChildAdded:Connect(onAdd))
		table.insert(handle.conns, folder.ChildRemoved:Connect(onRemove))
		for _, child in ipairs(folder:GetChildren()) do
			onAdd(child)
		end
	end
	handle.addConn = Workspace.ChildAdded:Connect(function(child)
		if child.Name == name then
			bind(child)
		end
	end)
	handle.removeConn = Workspace.ChildRemoved:Connect(function(child)
		if child == handle.folder then
			bind(nil)
		end
	end)
	bind(Workspace:FindFirstChild(name))
	function handle.Stop()
		handle.addConn:Disconnect()
		handle.removeConn:Disconnect()
		for _, conn in ipairs(handle.conns) do
			conn:Disconnect()
		end
		handle.conns = {}
		handle.folder = nil
	end
	return handle
end

