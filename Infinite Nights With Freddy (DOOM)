do
	local InfoViewer = {
		player = nil,
		conns = {},
		backpackConns = {},
		charConns = {},
		amountConns = {},
		dirty = false,
		setters = {},
		tools = nil,
	}

	local InfoFields = { "Cash", "Class", "FazCoins", "Inventory", "Shop", "Chat Available", "EquippedTitle" }

	local bindInfoPlayer

	local function infoPlayerOptions()
		return listOtherPlayers()
	end

	local InfoDropdown = addDropdown("Info Viewer", {
		name = "Players",
		placeholder = "Players",
		multi = false,
		options = {},
		emptyText = "No Player Found",
		onChange = function(selectedSet)
			local name = next(selectedSet)
			local plr = name and Players:FindFirstChild(name) or nil
			if plr and not plr:IsA("Player") then
				plr = nil
			end
			bindInfoPlayer(plr)
		end,
	})
	InfoDropdown.SetOptions(infoPlayerOptions())

	for _, field in ipairs(InfoFields) do
		InfoViewer.setters[field] = addInfoRow("Info Viewer", field)
	end

	InfoViewer.tools = addLinesBox("Info Viewer", "Tools")

	local function formatNumber(value)
		if value ~= value or value == math.huge or value == -math.huge then
			return tostring(value)
		end
		local sign = value < 0 and "-" or ""
		local text = string.format("%.2f", math.abs(value))
		local whole, fraction = text:match("^(%d+)(%.%d+)$")
		if not whole then
			return tostring(value)
		end
		if fraction == ".00" then
			fraction = ""
		end
		local grouped = whole:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		grouped = grouped:gsub("^,", "")
		return sign .. grouped .. fraction
	end

	local function formatInfoValue(value)
		if value == nil then
			return "N/A"
		end
		if type(value) == "number" then
			return formatNumber(value)
		end
		if type(value) == "string" then
			return value == "" and "None" or value
		end
		return tostring(value)
	end

	local function isEnabledText(value)
		return tostring(value):lower() == "enabled"
	end

	local function infoFieldText(plr, field)
		if field == "Inventory" then
			return plr:GetAttribute("Inventory") == true and "true" or "false"
		end
		if field == "Chat Available" then
			local enabled = isEnabledText(plr:GetAttribute("ChatAvailabilityStatus"))
			local status = plr:FindFirstChild("ChatAvailabilityStatus")
			if not enabled and status and status:IsA("ValueBase") then
				enabled = isEnabledText(status.Value)
			end
			return enabled and "true" or "false"
		end
		return formatInfoValue(plr:GetAttribute(field))
	end

	local function collectToolLines(plr)
		local totals = {}
		local order = {}
		local function add(container)
			if not container then
				return
			end
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") then
					local amount = 1
					local config = child:FindFirstChild("Configuration")
					local value = config and config:FindFirstChild("ToolAmount")
					if value and value:IsA("ValueBase") and type(value.Value) == "number" then
						amount = value.Value
					end
					if totals[child.Name] == nil then
						totals[child.Name] = 0
						table.insert(order, child.Name)
					end
					totals[child.Name] += amount
				end
			end
		end
		add(plr:FindFirstChildOfClass("Backpack"))
		add(plr.Character)
		table.sort(order, function(a, b)
			return a:lower() < b:lower()
		end)
		local lines = {}
		for _, name in ipairs(order) do
			local total = totals[name]
			if total ~= 1 then
				table.insert(lines, name .. " x" .. formatNumber(total))
			else
				table.insert(lines, name)
			end
		end
		return lines
	end

	local function refreshInfo()
		local plr = InfoViewer.player
		if not plr or not plr.Parent then
			for _, field in ipairs(InfoFields) do
				InfoViewer.setters[field]("-")
			end
			InfoViewer.tools.Set({}, "Select a player")
			return
		end
		for _, field in ipairs(InfoFields) do
			InfoViewer.setters[field](infoFieldText(plr, field))
		end
		local lines = collectToolLines(plr)
		local note = nil
		if not plr:FindFirstChildOfClass("Backpack") then
			if #lines == 0 then
				note = "Backpack is hidden by the game. No tool in hand."
			else
				note = "Backpack is hidden by the game. Showing the tool in hand only."
			end
		elseif #lines == 0 then
			note = "No tools"
		end
		InfoViewer.tools.Set(lines, note)
	end

	local function scheduleInfoRefresh()
		if InfoViewer.dirty then
			return
		end
		InfoViewer.dirty = true
		task.defer(function()
			InfoViewer.dirty = false
			pcall(refreshInfo)
		end)
	end

	local function infoRelevant(inst)
		return inst:IsA("Tool") or inst.Name == "Configuration" or inst.Name == "ToolAmount"
	end

	local function hookAmount(inst)
		if (inst.Name == "ToolAmount" or inst.Name == "ChatAvailabilityStatus") and inst:IsA("ValueBase") and not InfoViewer.amountConns[inst] then
			InfoViewer.amountConns[inst] = inst.Changed:Connect(scheduleInfoRefresh)
		end
	end

	local function unhookAmount(inst)
		local conn = InfoViewer.amountConns[inst]
		if conn then
			conn:Disconnect()
			InfoViewer.amountConns[inst] = nil
		end
	end

	local function disconnectList(list)
		for _, conn in ipairs(list) do
			conn:Disconnect()
		end
		table.clear(list)
	end

	local function hookContainer(container, list)
		table.insert(list, container.DescendantAdded:Connect(function(inst)
			hookAmount(inst)
			if infoRelevant(inst) then
				scheduleInfoRefresh()
			end
		end))
		table.insert(list, container.DescendantRemoving:Connect(function(inst)
			unhookAmount(inst)
			if infoRelevant(inst) then
				scheduleInfoRefresh()
			end
		end))
		for _, descendant in ipairs(container:GetDescendants()) do
			hookAmount(descendant)
		end
	end

	local function unbindInfo()
		disconnectList(InfoViewer.conns)
		disconnectList(InfoViewer.backpackConns)
		disconnectList(InfoViewer.charConns)
		for _, conn in pairs(InfoViewer.amountConns) do
			conn:Disconnect()
		end
		table.clear(InfoViewer.amountConns)
		InfoViewer.player = nil
	end

	bindInfoPlayer = function(plr)
		unbindInfo()
		InfoViewer.player = plr
		if plr then
			table.insert(InfoViewer.conns, plr.AttributeChanged:Connect(scheduleInfoRefresh))
			table.insert(InfoViewer.conns, plr.ChildAdded:Connect(function(child)
				if child:IsA("Backpack") then
					disconnectList(InfoViewer.backpackConns)
					hookContainer(child, InfoViewer.backpackConns)
					scheduleInfoRefresh()
				end
				if child.Name == "ChatAvailabilityStatus" then
					hookAmount(child)
					scheduleInfoRefresh()
				end
			end))
			table.insert(InfoViewer.conns, plr.ChildRemoved:Connect(function(child)
				if child:IsA("Backpack") then
					disconnectList(InfoViewer.backpackConns)
					scheduleInfoRefresh()
				end
				if child.Name == "ChatAvailabilityStatus" then
					unhookAmount(child)
					scheduleInfoRefresh()
				end
			end))
			local chatStatus = plr:FindFirstChild("ChatAvailabilityStatus")
			if chatStatus then
				hookAmount(chatStatus)
			end
			table.insert(InfoViewer.conns, plr.CharacterAdded:Connect(function(char)
				disconnectList(InfoViewer.charConns)
				hookContainer(char, InfoViewer.charConns)
				scheduleInfoRefresh()
			end))
			table.insert(InfoViewer.conns, plr.CharacterRemoving:Connect(function()
				disconnectList(InfoViewer.charConns)
				scheduleInfoRefresh()
			end))
			local backpack = plr:FindFirstChildOfClass("Backpack")
			if backpack then
				hookContainer(backpack, InfoViewer.backpackConns)
			end
			if plr.Character then
				hookContainer(plr.Character, InfoViewer.charConns)
			end
		end
		refreshInfo()
	end

	local infoOptionsPending = false
	local function scheduleInfoOptions()
		if infoOptionsPending then
			return
		end
		infoOptionsPending = true
		task.delay(0.2, function()
			infoOptionsPending = false
			InfoDropdown.SetOptions(infoPlayerOptions())
		end)
	end

	local InfoPlayerAddedConn = Players.PlayerAdded:Connect(scheduleInfoOptions)
	local InfoPlayerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
		if plr == InfoViewer.player then
			bindInfoPlayer(nil)
		end
		scheduleInfoOptions()
	end)

	bindInfoPlayer(nil)
	table.insert(CleanupFns, function()
		unbindInfo()
		InfoPlayerAddedConn:Disconnect()
		InfoPlayerRemovingConn:Disconnect()
	end)
end

