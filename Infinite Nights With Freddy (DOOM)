		PlaceholderText = "Search...",
		PlaceholderColor3 = COLOR_MUTED,
		TextColor3 = COLOR_TEXT,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = true,
		BorderSizePixel = 0,
		LayoutOrder = 0,
	}, list)
	addCorner(searchBox, 5)
	makeInst("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, searchBox)
	local function fillAll()
		table.clear(object.selected)
		for _, name in ipairs(object.options) do
			object.selected[name] = true
		end
	end
	local function rebuild()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local visible = {}
		for _, name in ipairs(object.options) do
			if object.query == "" or labelOf(name):lower():find(object.query, 1, true) or name:lower():find(object.query, 1, true) then
				table.insert(visible, name)
			end
		end
		if config.selectAll then
			local allButton = makeInst("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = object.allMode and COLOR_BLUE or COLOR_ROW,
				Text = "Select All",
				TextColor3 = COLOR_TEXT,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				LayoutOrder = 1,
			}, list)
			addCorner(allButton, 5)
			makeInst("UIPadding", { PaddingLeft = UDim.new(0, 8) }, allButton)
			allButton.MouseButton1Click:Connect(function()
				if object.allMode then
					object.allMode = false
					table.clear(object.selected)
				else
					object.allMode = true
					fillAll()
				end
				rebuild()
				renderHeader()
				notifyChange()
			end)
		end
		if #visible == 0 then
			makeInst("TextLabel", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				Text = #object.options == 0 and (config.emptyText or "Nothing found") or "No items found",
				TextColor3 = COLOR_MUTED,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				LayoutOrder = 2,
			}, list)
		end
		for index, name in ipairs(visible) do
			local picked = not object.allMode and object.selected[name] == true
			local optionButton = makeInst("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = picked and COLOR_BLUE or COLOR_ROW,
				Text = labelOf(name),
				TextColor3 = COLOR_TEXT,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				LayoutOrder = index + 2,
			}, list)
			addCorner(optionButton, 5)
			makeInst("UIPadding", { PaddingLeft = UDim.new(0, 8) }, optionButton)
			optionButton.MouseButton1Click:Connect(function()
				if config.multi then
					if object.allMode then
						object.allMode = false
						table.clear(object.selected)
						object.selected[name] = true
					elseif object.selected[name] then
						object.selected[name] = nil
					else
						object.selected[name] = true
					end
				else
					table.clear(object.selected)
					object.selected[name] = true
					object.open = false
					list.Visible = false
				end
				rebuild()
				renderHeader()
				notifyChange()
			end)
		end
		local count = math.max(1, #visible) + (config.selectAll and 1 or 0)
		local rows = math.min(count, 5)
		list.Size = UDim2.new(1, 0, 0, rows * 31 + 8 + 31)
	end
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		object.query = searchBox.Text:lower()
		rebuild()
	end)
	function object.SetOptions(options, labels)
		object.options = options
		object.labels = labels or {}
		local optionSet = {}
		for _, name in ipairs(options) do
			optionSet[name] = true
		end
		local changed = false
		if object.allMode then
			for _, name in ipairs(options) do
				if not object.selected[name] then
					changed = true
				end
			end
			for name in pairs(object.selected) do
				if not optionSet[name] then
					changed = true
				end
			end
			fillAll()
		else
			for name in pairs(object.selected) do
				if not optionSet[name] then
					object.selected[name] = nil
					changed = true
				end
			end
		end
		rebuild()
		renderHeader()
		if changed then
			notifyChange()
		end
	end
	header.MouseButton1Click:Connect(function()
		object.open = not object.open
		list.Visible = object.open
		renderHeader()
	end)
	object.SetOptions(config.options or {}, config.labels)
	return object
end

