local God = { on = false, hooked = false }

local function installGodHook()
	if God.hooked then
		return true
	end
	local hook = Env.hookmetamethod
	local getMethod = Env.getnamecallmethod
	if not hook or not getMethod then
		return false
	end
	local old
	local function handler(self, ...)
		if God.on and getMethod() == "FireServer" and typeof(self) == "Instance" and self.Name == "AttackEvent" then
			local folder = Workspace:FindFirstChild("Animatronics")
			if folder and self:IsDescendantOf(folder) then
				return nil
			end
		end
		return old(self, ...)
	end
	local wrapped = Env.newcclosure and Env.newcclosure(handler) or handler
	local ok, result = pcall(hook, game, "__namecall", wrapped)
	if not ok or not result then
		return false
	end
	old = result
	God.hooked = true
	return true
end

