	if root and cf then
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

local holdBusy = {}

local function firePrompt(prompt)
	local fire = Env.fireproximityprompt
	if fire then
		pcall(fire, prompt)
		return
	end
	if holdBusy[prompt] then
		return
	end
	holdBusy[prompt] = true
	task.spawn(function()
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(math.max(prompt.HoldDuration, 0) + 0.05)
			prompt:InputHoldEnd()
		end)
		holdBusy[prompt] = nil
	end)
end

local function ownsPart(part)
	if part.Anchored then
		return false
	end
	local fn = Env.isnetworkowner
	if fn then
		local ok, result = pcall(fn, part)
		return ok and result == true
	end
	local ok, age = pcall(function()
		return part.ReceiveAge
	end)
	return ok and age == 0
end

