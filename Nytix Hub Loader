	shrink:Play()
	fade.Completed:Wait()
	cleanup()
	if afterClose then
		afterClose()
	end
end

local function getState(entry)
	if type(entry.link) ~= "string" or entry.link == "" then
		return false, "Link missing"
	end
	if not entry.placeId then
		return false, "Place ID missing"
	end
	if entry.lobbyPlaceId and game.PlaceId == entry.lobbyPlaceId then
		return true, "Execute", true
	end
	if game.PlaceId ~= entry.placeId then
		return false, "Nothing Supported"
	end
	return true, "Execute", false
end

