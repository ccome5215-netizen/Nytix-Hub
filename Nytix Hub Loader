local function makeSpinner(diameter, thickness)
	local spinner = makeInst("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundTransparency = 1,
	}, nil)
	local ring = makeInst("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, spinner)
	addCorner(ring, diameter)
	local stroke = makeInst("UIStroke", {
		Color = Color3.fromRGB(255, 255, 255),
		Thickness = thickness,
		Transparency = 0.15,
	}, ring)
	addGradient(stroke, 0)
	for i = 1, 3 do
		local angle = math.rad(i * 120)
		local dot = makeInst("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(angle) * diameter / 2, 0.5, math.sin(angle) * diameter / 2),
			Size = UDim2.fromOffset(thickness * 3, thickness * 3),
			BackgroundColor3 = i == 1 and COLOR_PINK or (i == 2 and COLOR_VIOLET or Color3.fromRGB(63, 201, 255)),
			BorderSizePixel = 0,
		}, spinner)
		addCorner(dot, thickness * 3)
	end
	return spinner
end

