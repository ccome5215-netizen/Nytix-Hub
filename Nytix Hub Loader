local function closeHub(afterClose)
	if closing then
		return
	end
	closing = true
	local info = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local fade = TweenService:Create(WindowFrame, info, { GroupTransparency = 1 })
	local shrink = TweenService:Create(WindowScale, info, { Scale = 0.85 })
