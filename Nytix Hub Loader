		Size = UDim2.fromOffset(122, 30),
		Position = UDim2.new(1, -130, 0.5, -15),
		BackgroundColor3 = supported and COLOR_CYAN or COLOR_GRAY,
		Text = label,
		TextColor3 = supported and COLOR_TEXT or COLOR_MUTED,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, row)
	addCorner(button, 6)
	if label == "Place ID missing" then
		table.insert(warnings, entry.name .. ": no Place ID set.")
	elseif label == "Link missing" then
		table.insert(warnings, entry.name .. ": no link set.")
	end
	local lastNotice = 0
	if supported then
		track(button.MouseButton1Click:Connect(function()
			if busy or closing then
				return
			end
			if inLobby then
				local now = os.clock()
				if now - lastNotice >= 1 then
					lastNotice = now
					pcall(function()
						StarterGui:SetCore("SendNotification", {
							Title = "Nytix Hub",
							Text = "You are in lobby. Please join the In Game, not In Lobby.",
							Duration = 5,
						})
					end)
				end
				return
			end
			busy = true
			button.Text = "Loading..."
			button.BackgroundColor3 = COLOR_GRAY
			button.TextColor3 = COLOR_MUTED
			setWarning("")
			task.spawn(function()
				local ok, source = pcall(function()
					return game:HttpGet(entry.link)
				end)
				if not Alive then
					return
				end
				if not ok or type(source) ~= "string" or source == "" then
					setWarning("Download failed for " .. entry.name .. ". Try again.")
					button.Text = "Execute"
					button.BackgroundColor3 = COLOR_CYAN
					button.TextColor3 = COLOR_TEXT
					busy = false
					return
				end
				local fn, compileError = loadstring(source)
				if not fn then
					setWarning("Script error for " .. entry.name .. ": " .. tostring(compileError))
					button.Text = "Execute"
					button.BackgroundColor3 = COLOR_CYAN
					button.TextColor3 = COLOR_TEXT
					busy = false
					return
				end
				closeHub(function()
					local runOk, runError = pcall(fn)
					if not runOk then
						warn("[Nytix Hub] " .. tostring(runError))
					end
				end)
			end)
		end))
	end
end

