local NAME_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*"

local function randomName()
	local result = {}
	for i = 1, 16 do
		local index = math.random(1, #NAME_CHARS)
		result[i] = string.sub(NAME_CHARS, index, index)
	end
	return table.concat(result)
end

local function getGuiParent()
	if gethui then
		local ok, result = pcall(gethui)
		if ok and result then
			return result
		end
	end
	local ok = pcall(function()
		return CoreGui.Name
	end)
	if ok then
		return CoreGui
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local Connections = {}
local Alive = true
local Guis = {}

local function track(connection)
	table.insert(Connections, connection)
	return connection
end

local function makeInst(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function addCorner(inst, radius)
	makeInst("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function addGradient(inst, rotation)
	makeInst("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, COLOR_PINK),
			ColorSequenceKeypoint.new(0.5, COLOR_VIOLET),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(63, 201, 255)),
		}),
		Rotation = rotation or 0,
	}, inst)
end

local function cleanup()
	Alive = false
	for _, connection in ipairs(Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	Connections = {}
	for _, gui in ipairs(Guis) do
		pcall(function()
			gui:Destroy()
		end)
	end
	Guis = {}
end

