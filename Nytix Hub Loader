	makeInst("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, EnterButton)
	local CopyButton = makeInst("TextButton", {
		Size = UDim2.new(1, -24, 0, 36),
		Position = UDim2.fromOffset(12, 174),
		BackgroundColor3 = COLOR_VIOLET,
		Text = "Copy Link",
		TextColor3 = COLOR_TEXT,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, KeyGroup)
	addCorner(CopyButton, 6)
	makeInst("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8 }, CopyButton)
	makeInst("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, CopyButton)
	local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(KeyGroup, info, { GroupTransparency = 0 }):Play()
	TweenService:Create(KeyScale, info, { Scale = 1 }):Play()
	local keyDone = false
	local function fadeKey(afterFade)
		if keyDone then
			return
		end
		keyDone = true
		task.spawn(function()
			local out = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			local fade = TweenService:Create(KeyGroup, out, { GroupTransparency = 1 })
			TweenService:Create(KeyScale, out, { Scale = 0.9 }):Play()
			fade:Play()
			fade.Completed:Wait()
			afterFade()
		end)
	end
	track(KeyClose.MouseButton1Click:Connect(function()
		fadeKey(cleanup)
	end))
	local verifying = false
	local function verify(text, automatic)
		if verifying or keyDone then
			return
		end
		verifying = true
		KeyStatus.Text = ""
		EnterButton.BackgroundColor3 = COLOR_GRAY
		for step = 0, 3 do
			if not Alive then
				return
			end
			EnterButton.Text = "Verifying" .. string.rep(".", (step % 3) + 1)
			task.wait(0.25)
		end
		if not Alive then
			return
		end
		local correct = KEY ~= "" and text == KEY
		if correct then
			if automatic then
				EnterButton.Text = "Verified"
				KeyStatus.TextColor3 = COLOR_MUTED
				KeyStatus.Text = "Saved Key is correct"
				task.wait(0.8)
			else
				saveKey(text)
			end
			if not Alive then
				return
			end
			fadeKey(function()
				KeyGui:Destroy()
			end)
			showWindow()
			return
		end
		if automatic then
			deleteSavedKey()
			KeyBox.Text = ""
			KeyStatus.TextColor3 = COLOR_WARN
			KeyStatus.Text = "Key Has Been Changed. Go to Discord and get the new key."
			EnterButton.Text = "Enter Key"
			EnterButton.BackgroundColor3 = COLOR_CYAN
		else
			EnterButton.Text = "Wrong Key"
			EnterButton.BackgroundColor3 = Color3.fromRGB(180, 55, 55)
			task.wait(1.5)
			if not Alive then
				return
			end
			EnterButton.Text = "Enter Key"
			EnterButton.BackgroundColor3 = COLOR_CYAN
		end
		verifying = false
	end
	track(EnterButton.MouseButton1Click:Connect(function()
		task.spawn(verify, KeyBox.Text, false)
	end))
	local copying = false
	track(CopyButton.MouseButton1Click:Connect(function()
		if copying then
			return
		end
		copying = true
		task.spawn(function()
			if type(setclipboard) ~= "function" then
				CopyButton.Text = "Your executor didn't have this function"
				CopyButton.BackgroundColor3 = Color3.fromRGB(180, 55, 55)
			else
				local ok = pcall(setclipboard, DISCORD_LINK)
				if ok then
					CopyButton.Text = "Copied Link"
					CopyButton.BackgroundColor3 = Color3.fromRGB(50, 170, 80)
				else
					CopyButton.Text = "Copy Link Failed"
					CopyButton.BackgroundColor3 = Color3.fromRGB(180, 55, 55)
				end
			end
			task.wait(1.5)
			if not Alive then
				return
			end
			CopyButton.Text = "Copy Link"
			CopyButton.BackgroundColor3 = COLOR_VIOLET
			copying = false
		end)
	end))
	local savedKey = readSavedKey()
	if savedKey then
		KeyBox.Text = savedKey
		task.spawn(function()
			task.wait(0.45)
			verify(savedKey, true)
		end)
	end
end

task.spawn(function()
	TweenService:Create(BarFill, TweenInfo.new(LOADING_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
		Size = UDim2.fromScale(1, 1),
	}):Play()
	local steps = {
		{ 0, "Warping into the galaxy..." },
		{ 0.25, "Scanning stars..." },
		{ 0.55, "Loading games..." },
		{ 0.8, "Ready!" },
	}
	local last = 0
	for _, step in ipairs(steps) do
		local at = step[1] * LOADING_TIME
		task.wait(at - last)
		last = at
		if not Alive then
			return
		end
		StatusLabel.Text = step[2]
	end
	task.wait(LOADING_TIME - last)
	if not Alive then
		return
	end
	TweenService:Create(LoadingGroup, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		GroupTransparency = 1,
	}):Play()
	if KEY_SYSTEM_ENABLED then
		showKeyWindow()
	else
		showWindow()
	end
	task.wait(0.45)
	if Alive then
		LoadingGui:Destroy()
	end
end)
